{
  "parser": "progression_numeral.v1",
  "description": "How a progression numeral, as an admin writes it, is read in a mode: its canonical form, root, quality and whether it is borrowed, or that it isn't a numeral. Rules: README.md.",
  "cases": [
    {
      "name": "Major tonic",
      "input": "I",
      "mode": "major",
      "expected": {
        "status": "parsed",
        "numeral": "I",
        "root_semitones": 0,
        "quality": "major",
        "borrowed": false
      }
    },
    {
      "name": "Minor supertonic in major",
      "input": "ii",
      "mode": "major",
      "expected": {
        "status": "parsed",
        "numeral": "ii",
        "root_semitones": 2,
        "quality": "minor",
        "borrowed": false
      }
    },
    {
      "name": "Leading-tone diminished in major",
      "input": "vii°",
      "mode": "major",
      "expected": {
        "status": "parsed",
        "numeral": "vii°",
        "root_semitones": 11,
        "quality": "diminished",
        "borrowed": false
      }
    },
    {
      "name": "Dominant seventh is diatonic: a seventh doesn't change the triad",
      "input": "V7",
      "mode": "major",
      "expected": {
        "status": "parsed",
        "numeral": "V7",
        "root_semitones": 7,
        "quality": "dominant_7",
        "borrowed": false
      }
    },
    {
