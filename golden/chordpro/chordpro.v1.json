{
  "format": "chordpro.v1",
  "description": "ChordPro text -> the song chart draft it imports as (metadata, document, warnings) -> the ChordPro that draft exports as. Rules in README.md.",
  "cases": [
    {
      "name": "metadata, a verse and a chorus",
      "input": "{title: Asa Branca}\n{artist: Luiz Gonzaga}\n{key: G}\n{capo: 2}\n{tempo: 96}\n{time: 2/4}\n\n{start_of_verse}\n[G]Quando olhei a [C]terra ardendo\n{end_of_verse}\n\n{start_of_chorus}\n[D]Que braseiro, que for[G]nalha\n{end_of_chorus}\n",
      "expected": {
        "metadata": {
          "title": "Asa Branca",
          "artist": "Luiz Gonzaga",
          "concert_key": "G",
          "capo_fret": 2,
          "tempo_bpm": 96,
          "time_signature": {
            "beats": 2,
            "beat_value": 4
          }
        },
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "section",
              "attrs": {
                "kind": "verse",
                "label": null
              },
              "content": [
                {
                  "type": "lyricLine",
                  "content": [
                    {
                      "type": "text",
                      "text": "Quando olhei a ",
                      "marks": [
                        {
                          "type": "chordAnchor",
                          "attrs": {
                            "anchorId": "a1",
                            "writtenSymbol": "G",
                            "chordDefinitionId": null,
                            "chordVoicingId": null
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "terra ardendo",
                      "marks": [
                        {
                          "type": "chordAnchor",
                          "attrs": {
                            "anchorId": "a2",
                            "writtenSymbol": "C",
                            "chordDefinitionId": null,
                            "chordVoicingId": null
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "section",
              "attrs": {
                "kind": "chorus",
                "label": null
              },
              "content": [
                {
                  "type": "lyricLine",
                  "content": [
                    {
                      "type": "text",
                      "text": "Que braseiro, que for",
                      "marks": [
                        {
                          "type": "chordAnchor",
                          "attrs": {
                            "anchorId": "a3",
                            "writtenSymbol": "D",
                            "chordDefinitionId": null,
                            "chordVoicingId": null
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "nalha",
                      "marks": [
                        {
                          "type": "chordAnchor",
                          "attrs": {
                            "anchorId": "a4",
                            "writtenSymbol": "G",
                            "chordDefinitionId": null,
                            "chordVoicingId": null
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "import_warnings": []
      },
      "export": "{title: Asa Branca}\n{artist: Luiz Gonzaga}\n{key: G}\n{capo: 2}\n{tempo: 96}\n{time: 2/4}\n\n{start_of_verse}\n[G]Quando olhei a [C]terra ardendo\n{end_of_verse}\n\n{start_of_chorus}\n[D]Que braseiro, que for[G]nalha\n{end_of_chorus}\n"
    },
