{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motifpath.io/specs/golden/practice-graders/schema.json",
  "title": "Practice grader golden cases",
  "description": "One file per grader version: the reference data the grader reads, and cases of item key + raw response -> expected result. Each case's item_key and response must also be valid against PracticeItemKey and PracticeResponse in openapi/components/schemas/practice.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["grader", "description", "reference", "cases"],
  "properties": {
    "grader": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*\\.v[1-9][0-9]*$",
      "description": "The grader id these cases pin, as <name>.v<version>. Matches the file name."
    },
    "description": { "type": "string", "minLength": 1 },
    "reference": {
      "type": "object",
      "description": "The reference data the grader reads. Anything an item key points at that is missing here is unknown to the grader.",
      "additionalProperties": false,
      "properties": {
        "instruments": {
          "type": "object",
          "description": "Layout instruments by id.",
          "propertyNames": { "format": "uuid" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "tuning"],
            "properties": {
              "name": { "type": "string" },
              "tuning": {
                "type": "array",
                "minItems": 1,
                "description": "Open-string pitch per string with its octave, lowest string first (the last entry is string 1).",
                "items": { "type": "string", "pattern": "^[A-G]#?[0-9]$" }
              }
            }
          }
        },
        "exercises": {
          "type": "object",
          "description": "Authored exercises by id: their options and which of them are correct.",
          "propertyNames": { "format": "uuid" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "option_ids", "correct_option_ids"],
            "properties": {
              "name": { "type": "string" },
              "option_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
              "correct_option_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
            }
          }
        },
        "diagrams": {
          "type": "object",
          "description": "Diagrams that exist, by id.",
          "propertyNames": { "format": "uuid" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string" } }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "item_key", "response", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "item_key": { "type": "string" },
          "response": { "type": "object" },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["result", "evidence"],
                "properties": {
                  "result": { "const": "graded" },
                  "evidence": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["source", "correct", "latency_ms", "answer_key"],
                        "properties": {
                          "source": { "const": "auto_graded" },
                          "correct": { "type": "boolean" },
                          "latency_ms": { "type": "integer", "minimum": 0 },
                          "audio_ms": { "type": "integer", "minimum": 0 },
                          "answer_key": {
                            "description": "What a right answer was, kept so a disputed answer can be checked without the reference data of the day: the asked cell and its note (spelled with sharps), or every option of the exercise as shown, each with whether it was correct.",
                            "oneOf": [
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["string", "fret", "note_name"],
                                "properties": {
                                  "string": { "type": "integer", "minimum": 1 },
                                  "fret": { "type": "integer", "minimum": 0 },
                                  "note_name": { "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"] }
                                }
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["options"],
                                "properties": {
                                  "options": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": ["option_id", "is_correct"],
                                      "properties": {
                                        "option_id": { "type": "string" },
                                        "is_correct": { "type": "boolean" }
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["source", "rating"],
                        "properties": {
                          "source": { "const": "self_assessed" },
                          "rating": { "enum": ["struggled", "almost", "clean"] },
                          "tempo_bpm": { "type": "integer", "minimum": 1 },
                          "changes_per_minute": { "type": "integer", "minimum": 0 }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["result", "reason"],
                "properties": {
                  "result": { "const": "rejected" },
                  "reason": {
                    "enum": [
                      "response_does_not_fit_item",
                      "unknown_reference",
                      "invalid_cell",
                      "unknown_option",
                      "measure_missing"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
